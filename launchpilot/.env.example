# Claude API key (https://console.anthropic.com). Required for AI writing, page analysis and directory discovery.
ANTHROPIC_API_KEY=

# Model used for all AI work. Default: claude-opus-5-5
LAUNCHPILOT_MODEL=claude-opus-5-5

# Encrypts saved platform passwords (AES-256-GCM). Use a long random string and keep it safe:
# losing it means saved passwords can't be decrypted. If unset, one is generated in data/.master.key
LAUNCHPILOT_MASTER_KEY=

# Password for the LaunchPilot dashboard. Required when HOST is not 127.0.0.1/localhost.
LAUNCHPILOT_APP_PASSWORD=

HOST=127.0.0.1
PORT=4310

# false = show the real browser window so you can solve CAPTCHAs / email checks and click the final Submit.
# true  = run invisibly (servers). Sites with CAPTCHAs will stop at "needs you".
LAUNCHPILOT_HEADLESS=false

# Optional: path to an existing Chromium/Chrome binary instead of Playwright's bundled one.
CHROMIUM_PATH=

# ---- Hosted version (Vercel) only; see README "Hosted version on Vercel" ----
# Turn on hosted mode when running outside Vercel (Vercel sets VERCEL automatically).
# LAUNCHPILOT_CLOUD=1
# LAUNCHPILOT_SECRET=          # long random string; signs sessions, derives per-user vault keys
# KV_REST_API_URL=             # Upstash Redis (added by the Vercel Marketplace integration)
# KV_REST_API_TOKEN=
# LAUNCHPILOT_STORE_DIR=       # local testing instead of Redis
# CRON_SECRET=
# LAUNCHPILOT_INVITE_CODE=
# LAUNCHPILOT_DAILY_AI_LIMIT=150
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
